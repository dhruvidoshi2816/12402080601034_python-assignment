import json
from collections import defaultdict

def read_records(path):
    with open(path, "r") as file:
        for line in file:
            try:
                record = json.loads(line)
                yield record
            except json.JSONDecodeError:
                yield None


def process_records(path):
    data = defaultdict(lambda: {
        "count": 0,
        "min": float("inf"),
        "max": float("-inf"),
        "total": 0,
        "corrupted": 0
    })

    for record in read_records(path):
        if record is None:
            continue

        device = record.get("device_id")

        if not device:
            continue

        try:
            temp = float(record["temperature_c"])
            float(record["humidity"])

            if not (-100 <= temp <= 100):
                raise ValueError

            stats = data[device]
            stats["count"] += 1
            stats["total"] += temp
            stats["min"] = min(stats["min"], temp)
            stats["max"] = max(stats["max"], temp)

        except (ValueError, TypeError, KeyError):
            data[device]["corrupted"] += 1

    for device in sorted(data):
        stats = data[device]

        if stats["count"] > 0:
            average = stats["total"] / stats["count"]
            print(
                f"{device} count={stats['count']} "
                f"min={stats['min']:g} max={stats['max']:g} "
                f"avg={average:.2f} corrupted={stats['corrupted']}"
            )
        else:
            print(f"{device} count=0 corrupted={stats['corrupted']}")


path = input("Enter JSONL file path: ")
process_records(path)
