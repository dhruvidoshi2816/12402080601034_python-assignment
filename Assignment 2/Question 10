import pandas as pd
import matplotlib.pyplot as plt
import os

file_path = input("Enter marks CSV file path: ")
output_folder = input("Enter output folder path: ")

os.makedirs(output_folder, exist_ok=True)

df = pd.read_csv(file_path)

id_columns = ["enrollment", "name"]
subjects = [col for col in df.columns if col not in id_columns]

for subject in subjects:
    df[subject] = pd.to_numeric(df[subject], errors="coerce")
    df[subject] = df[subject].fillna(df[subject].mean())
    df[subject] = df[subject].fillna(0)
    df[subject] = df[subject].clip(0, 100)

df.to_csv(
    os.path.join(output_folder, "cleaned_marks.csv"),
    index=False
)

df["Average"] = df[subjects].mean(axis=1)

summary = df[subjects].agg(
    ["mean", "median", "min", "max"]
).T

summary.columns = ["Average", "Median", "Minimum", "Maximum"]
summary.to_csv(os.path.join(output_folder, "summary.csv"))

def get_grade(mark):
    if mark >= 90:
        return "A"
    elif mark >= 80:
        return "B"
    elif mark >= 70:
        return "C"
    elif mark >= 60:
        return "D"
    else:
        return "F"

df["Grade"] = df["Average"].apply(get_grade)

df["Grade"].value_counts().sort_index().plot(
    kind="bar", title="Grade Distribution"
)
plt.xlabel("Grade")
plt.ylabel("Number of Students")
plt.tight_layout()
plt.savefig(os.path.join(output_folder, "grade_distribution.png"))
plt.close()

summary["Average"].plot(
    kind="bar", title="Subject-wise Average Marks"
)
plt.xlabel("Subject")
plt.ylabel("Average Marks")
plt.tight_layout()
plt.savefig(os.path.join(output_folder, "subject_average.png"))
plt.close()

top_students = df.nlargest(10, "Average")
top_students.plot(
    x="name", y="Average", kind="bar",
    legend=False, title="Top 10 Performers"
)
plt.xlabel("Student")
plt.ylabel("Average Marks")
plt.tight_layout()
plt.savefig(os.path.join(output_folder, "top_performers.png"))
plt.close()

print("Files exported successfully:")
print("cleaned_marks.csv")
print("summary.csv")
print("grade_distribution.png")
print("subject_average.png")
print("top_performers.png")
