MOD = 1000000007

n, m = map(int, input().split())

matrix = []

for i in range(n):
    row = input().split()

    if len(row) == 1 and len(row[0]) == m:
        row = list(row[0])

    matrix.append(row)

if matrix[0][0] == "X" or matrix[n - 1][m - 1] == "X":
    print("IMPOSSIBLE")
else:
    prev_score = [None] * m
    prev_ways = [0] * m

    for i in range(n):
        curr_score = [None] * m
        curr_ways = [0] * m

        for j in range(m):
            if matrix[i][j] == "X":
                continue

            value = int(matrix[i][j])

            if i == 0 and j == 0:
                curr_score[j] = value
                curr_ways[j] = 1
                continue

            candidates = []

            if j > 0 and curr_score[j - 1] is not None:
                candidates.append(curr_score[j - 1])

            if prev_score[j] is not None:
                candidates.append(prev_score[j])

            if j > 0 and prev_score[j - 1] is not None:
                candidates.append(prev_score[j - 1])

            if not candidates:
                continue

            best = max(candidates)
            ways = 0

            if j > 0 and curr_score[j - 1] == best:
                ways += curr_ways[j - 1]

            if prev_score[j] == best:
                ways += prev_ways[j]

            if j > 0 and prev_score[j - 1] == best:
                ways += prev_ways[j - 1]

            curr_score[j] = best + value
            curr_ways[j] = ways % MOD

        prev_score = curr_score
        prev_ways = curr_ways

    if prev_score[m - 1] is None:
        print("IMPOSSIBLE")
    else:
        print(prev_score[m - 1], prev_ways[m - 1])
