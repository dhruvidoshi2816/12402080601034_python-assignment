import tkinter as tk
from tkinter import ttk, messagebox
import mysql.connector
import re

con = mysql.connector.connect(
    host="localhost",
    user="root",
    password="your_password",
    database="college"
)

cur = con.cursor()

cur.execute("""
    CREATE TABLE IF NOT EXISTS Contact (
        id INT AUTO_INCREMENT PRIMARY KEY,
        name VARCHAR(100),
        email VARCHAR(100) UNIQUE,
        phone VARCHAR(20),
        category VARCHAR(50),
        notes TEXT
    )
""")
con.commit()


def show_contacts():
    search = search_entry.get().strip()

    for item in table.get_children():
        table.delete(item)

    cur.execute("""
        SELECT id, name, email, phone, category, notes
        FROM Contact
        WHERE name LIKE %s OR email LIKE %s OR phone LIKE %s
        ORDER BY name
    """, (f"%{search}%", f"%{search}%", f"%{search}%"))

    for row in cur.fetchall():
        table.insert("", "end", values=row)


def add_contact():
    name = name_entry.get().strip()
    email = email_entry.get().strip()
    phone = phone_entry.get().strip()
    category = category_box.get()
    notes = notes_entry.get().strip()

    if not name or not email:
        messagebox.showerror("Error", "Name and email are required")
        return

    if not re.fullmatch(r"[A-Za-z0-9._+-]+@[A-Za-z0-9.-]+\.(com|edu|org)", email):
        messagebox.showerror("Error", "Invalid email")
        return

    try:
        cur.execute("""
            INSERT INTO Contact (name, email, phone, category, notes)
            VALUES (%s, %s, %s, %s, %s)
        """, (name, email, phone, category, notes))
        con.commit()
        show_contacts()
        messagebox.showinfo("Success", "Contact added")

    except mysql.connector.IntegrityError:
        messagebox.showerror("Error", "Email already exists")


def select_contact(event):
    selected = table.focus()

    if selected:
        values = table.item(selected, "values")

        name_entry.delete(0, tk.END)
        name_entry.insert(0, values[1])

        email_entry.delete(0, tk.END)
        email_entry.insert(0, values[2])

        phone_entry.delete(0, tk.END)
        phone_entry.insert(0, values[3])

        category_box.set(values[4])

        notes_entry.delete(0, tk.END)
        notes_entry.insert(0, values[5] or "")


def update_contact():
    selected = table.focus()

    if not selected:
        messagebox.showerror("Error", "Select a contact first")
        return

    contact_id = table.item(selected, "values")[0]
    email = email_entry.get().strip()

    if not re.fullmatch(r"[A-Za-z0-9._+-]+@[A-Za-z0-9.-]+\.(com|edu|org)", email):
        messagebox.showerror("Error", "Invalid email")
        return

    try:
        cur.execute("""
            UPDATE Contact
            SET name=%s, email=%s, phone=%s, category=%s, notes=%s
            WHERE id=%s
        """, (
            name_entry.get().strip(),
            email,
            phone_entry.get().strip(),
            category_box.get(),
            notes_entry.get().strip(),
            contact_id
        ))

        con.commit()
        show_contacts()

    except mysql.connector.IntegrityError:
        messagebox.showerror("Error", "Email already exists")


def delete_contact():
    selected = table.focus()

    if not selected:
        messagebox.showerror("Error", "Select a contact first")
        return

    contact_id = table.item(selected, "values")[0]

    cur.execute("DELETE FROM Contact WHERE id=%s", (contact_id,))
    con.commit()
    show_contacts()


root = tk.Tk()
root.title("Contact Manager")
root.geometry("900x550")

tk.Label(root, text="Name").grid(row=0, column=0)
name_entry = tk.Entry(root)
name_entry.grid(row=0, column=1)

tk.Label(root, text="Email").grid(row=1, column=0)
email_entry = tk.Entry(root)
email_entry.grid(row=1, column=1)

tk.Label(root, text="Phone").grid(row=2, column=0)
phone_entry = tk.Entry(root)
phone_entry.grid(row=2, column=1)

tk.Label(root, text="Category").grid(row=3, column=0)
category_box = ttk.Combobox(
    root, values=["Personal", "Faculty", "Friend", "Work"]
)
category_box.grid(row=3, column=1)
category_box.set("Personal")

tk.Label(root, text="Notes").grid(row=4, column=0)
notes_entry = tk.Entry(root)
notes_entry.grid(row=4, column=1)

tk.Button(root, text="Add", command=add_contact).grid(row=5, column=0)
tk.Button(root, text="Update", command=update_contact).grid(row=5, column=1)
tk.Button(root, text="Delete", command=delete_contact).grid(row=5, column=2)

tk.Label(root, text="Search").grid(row=6, column=0)
search_entry = tk.Entry(root)
search_entry.grid(row=6, column=1)
tk.Button(root, text="Search", command=show_contacts).grid(row=6, column=2)

table = ttk.Treeview(
    root,
    columns=("ID", "Name", "Email", "Phone", "Category", "Notes"),
    show="headings"
)

for col in ("ID", "Name", "Email", "Phone", "Category", "Notes"):
    table.heading(col, text=col)

table.grid(row=7, column=0, columnspan=4, sticky="nsew")
table.bind("<<TreeviewSelect>>", select_contact)

show_contacts()
root.mainloop()

cur.close()
con.close()
